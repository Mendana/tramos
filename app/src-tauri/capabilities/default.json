{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de la ventana principal",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://www.openstreetmap.org/*" },
        { "url": "https://github.com/Mendana/tramos/blob/main/*" }
      ]
    }
  ]
}
